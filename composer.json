{
    "name": "predictflow/sdk",
    "description": "Official PHP SDK for PredictFlow - demand forecasting, inventory intelligence, and pricing optimization for Shopify and WooCommerce stores",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "predictflow",
        "demand-forecasting",
        "inventory-intelligence",
        "ecommerce-analytics",
        "sdk",
        "api-client",
        "rest-api",
        "shopify",
        "woocommerce"
    ],
    "homepage": "https://predictflow.co",
    "authors": [
        {
            "name": "PredictFlow",
            "homepage": "https://predictflow.co"
        }
    ],
    "support": {
        "issues": "https://github.com/PredictFlow/php-sdk/issues",
        "source": "https://github.com/PredictFlow/php-sdk"
    },
    "require": {
        "php": ">=8.1",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "php-http/discovery": "^1.19"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.8",
        "guzzlehttp/psr7": "^2.7",
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^2.2",
        "friendsofphp/php-cs-fixer": "^3.59"
    },
    "autoload": {
        "psr-4": {
            "PredictFlow\\Sdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PredictFlow\\Sdk\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse",
        "cs": "php-cs-fixer fix --diff --dry-run",
        "cs:fix": "php-cs-fixer fix"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
